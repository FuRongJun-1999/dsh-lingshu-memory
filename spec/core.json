    "aggregate": "max",
    "clearance_operator": "gte",
    "dangling_relations": [
      "derived",
      "corroborating",
      "contradicting",
      "unknown"
    ],
    "unknown_to_max": true,
    "invalid_to_quarantine": true
  },
  "formation": {
    "quantifier": "any",
    "relation": "derived",
    "true_result": "derived",
    "false_result": "direct"
  },
  "edges": {
    "relations": [
      "derived",
      "corroborating",
      "contradicting",
      "unknown"
    ],
    "cross_tenant": "reject",
    "bind_target": [
      "node_id",
      "revision",
      "content_sha"
    ],
    "mutation": "reject",
    "correction": "new_revision",
    "cycles": "reject",
    "scope_composition": "intersection",
    "policy_tightening": "immediate",
    "policy_widening": "bounded_by_creation"
